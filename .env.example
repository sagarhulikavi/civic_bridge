# Sahyog Platform Environment Variables

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db" # Or "postgresql://postgres:password@localhost:5432/sahyog?schema=public"
JWT_SECRET=sahyog_super_secret_jwt_key_development_only_change_in_production_2026
JWT_EXPIRES_IN=7d

# File Upload & Media Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# AI & Intelligence Microservices
AI_SERVICE_URL=http://localhost:8000
INTELLIGENCE_SERVICE_URL=http://localhost:8001

# System Settings
MAINTENANCE_MODE=false
