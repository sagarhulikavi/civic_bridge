generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(uuid())
  displayId            String                   @unique
  name                 String
  email                String                   @unique
  phone                String?
  passwordHash         String
  preferredLanguage    String                   @default("en")
  role                 String                   @default("CITIZEN")
  status               String                   @default("ACTIVE")
  emailVerified        Boolean                  @default(false)
  emailVerifiedAt      DateTime?
  organizationId       String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  lastLoginAt          DateTime?
  auditLogs            AuditLog[]
  collaborationMembers CollaborationMember[]
  comments             Comment[]
  cookieConsents       CookieConsent[]
  emailTokens          EmailVerificationToken[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  problems             Problem[]                @relation("UserProblems")
  solutionUpdates      SolutionUpdate[]
  supportTickets       SupportTicket[]
  organization         Organization?            @relation(fields: [organizationId], references: [id])
}

model Organization {
  id                   String                  @id @default(uuid())
  displayId            String                  @unique
  name                 String
  type                 String
  description          String?
  website              String?
  email                String?
  phone                String?
  location             String?
  district             String?
  state                String?
  verificationStatus   String                  @default("VERIFIED")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  collaborationMembers CollaborationMember[]
  expertise            OrganizationExpertise[]
  matches              ProblemMatch[]
  users                User[]
}

model OrganizationExpertise {
  id                String       @id @default(uuid())
  organizationId    String
  expertiseName     String
  expertiseCategory String?
  description       String?
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  nameHi      String?
  nameKh      String?
  description String?
  icon        String?
  parentId    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  problems    Problem[]
}

model Problem {
  id                 String                 @id @default(uuid())
  displayId          String                 @unique
  reporterId         String
  title              String
  description        String?
  originalLanguage   String                 @default("en")
  categoryId         String?
  status             String                 @default("SUBMITTED")
  priority           String                 @default("MEDIUM")
  priorityScore      Int                    @default(50)
  priorityReasons    String?
  aiStatus           String                 @default("PENDING")
  verificationStatus String                 @default("PENDING")
  isDuplicate        Boolean                @default(false)
  duplicateOfId      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  aiAnalyses         AiAnalysis[]
  collaborations     Collaboration[]
  comments           Comment[]
  location           Location?
  nlpResults         NlpResult[]
  category           Category?              @relation(fields: [categoryId], references: [id])
  reporter           User                   @relation("UserProblems", fields: [reporterId], references: [id], onDelete: Cascade)
  clusterMembers     ProblemClusterMember[]
  expertise          ProblemExpertise[]
  matches            ProblemMatch[]
  media              ProblemMedia[]
  solutions          Solution[]
}

model ProblemMedia {
  id         String      @id @default(uuid())
  problemId  String
  mediaType  String
  fileUrl    String
  storageKey String
  mimeType   String
  fileSize   Int
  duration   Float?
  createdAt  DateTime    @default(now())
  asrResults AsrResult[]
  problem    Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Location {
  id           String   @id @default(uuid())
  problemId    String   @unique
  latitude     Float
  longitude    Float
  accuracy     Float?
  place        String?
  locality     String?
  city         String?
  district     String?
  state        String?
  country      String?  @default("India")
  postalCode   String?
  locationName String?
  rawAddress   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model AiAnalysis {
  id                String             @id @default(uuid())
  problemId         String
  modelName         String             @default("sahyog-multimodal-v1")
  modelVersion      String             @default("1.0.0")
  status            String             @default("SUCCESS")
  summary           String?
  confidence        Float              @default(0.0)
  processingTimeMs  Int                @default(0)
  visualFeatures    String?
  suggestedCategory String?
  suggestedPriority String?
  createdAt         DateTime           @default(now())
  problem           Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  classifications   AiClassification[]
}

model AiClassification {
  id              String     @id @default(uuid())
  aiAnalysisId    String
  categoryName    String
  subcategoryName String?
  confidence      Float
  isSelected      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  aiAnalysis      AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
}

model AsrResult {
  id         String       @id @default(uuid())
  mediaId    String
  language   String
  transcript String
  confidence Float        @default(0.0)
  modelName  String       @default("whisper-multilingual-v1")
  createdAt  DateTime     @default(now())
  media      ProblemMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model NlpResult {
  id                String   @id @default(uuid())
  problemId         String
  source            String
  language          String
  normalizedText    String?
  summary           String?
  keywords          String?
  entities          String?
  requiredExpertise String?
  confidence        Float    @default(0.0)
  createdAt         DateTime @default(now())
  problem           Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ProblemExpertise {
  id            String   @id @default(uuid())
  problemId     String
  expertiseName String
  importance    String   @default("HIGH")
  source        String   @default("AI")
  createdAt     DateTime @default(now())
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ProblemMatch {
  id             String       @id @default(uuid())
  problemId      String
  organizationId String
  matchScore     Int
  matchReasons   String
  matchStatus    String       @default("RECOMMENDED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  problem        Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ProblemCluster {
  id          String                 @id @default(uuid())
  name        String
  description String?
  categoryId  String?
  status      String                 @default("ACTIVE")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  members     ProblemClusterMember[]
}

model ProblemClusterMember {
  id              String         @id @default(uuid())
  clusterId       String
  problemId       String
  similarityScore Float          @default(0.0)
  createdAt       DateTime       @default(now())
  cluster         ProblemCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  problem         Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ProblemSimilarity {
  id              String   @id @default(uuid())
  problemId1      String
  problemId2      String
  similarityScore Float
  reasons         String?
  status          String   @default("POTENTIAL_DUPLICATE")
  createdAt       DateTime @default(now())
}

model Collaboration {
  id          String                @id @default(uuid())
  problemId   String
  createdById String
  status      String                @default("ACTIVE")
  startDate   DateTime              @default(now())
  targetDate  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  problem     Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  members     CollaborationMember[]
  comments    Comment[]
  solutions   Solution[]
}

model CollaborationMember {
  id              String        @id @default(uuid())
  collaborationId String
  userId          String?
  organizationId  String?
  role            String        @default("CONTRIBUTOR")
  status          String        @default("ACTIVE")
  joinedAt        DateTime      @default(now())
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
}

model Solution {
  id                 String           @id @default(uuid())
  problemId          String
  collaborationId    String
  title              String
  description        String?
  solutionType       String           @default("ENGINEERING")
  status             String           @default("DESIGN")
  progressPercentage Int              @default(20)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  collaboration      Collaboration    @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  problem            Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  updates            SolutionUpdate[]
}

model SolutionUpdate {
  id                 String   @id @default(uuid())
  solutionId         String
  updatedById        String
  title              String
  description        String
  progressPercentage Int
  stage              String
  createdAt          DateTime @default(now())
  solution           Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  updatedBy          User     @relation(fields: [updatedById], references: [id])
}

model Comment {
  id              String         @id @default(uuid())
  problemId       String
  collaborationId String?
  userId          String
  parentId        String?
  content         String
  createdAt       DateTime       @default(now())
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id])
  problem         Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String
  title         String
  message       String
  referenceType String?
  referenceId   String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(uuid())
  displayId   String   @unique
  userId      String?
  userEmail   String
  category    String
  subject     String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
}

model CookieConsent {
  id            String   @id @default(uuid())
  userId        String?
  anonymousId   String?
  essential     Boolean  @default(true)
  analytics     Boolean  @default(false)
  preferences   Boolean  @default(false)
  marketing     Boolean  @default(false)
  policyVersion String   @default("1.0.0")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  hashedToken String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}
